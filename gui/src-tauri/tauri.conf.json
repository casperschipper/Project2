{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Projekt 2",
  "version": "0.2.1",
  "identifier": "org.koenig.projekt2.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Projekt 2",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "externalBin": [
      "binaries/pr2-engine"
    ],
    "resources": {
      "../help": "help"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © Casper Schipper",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
